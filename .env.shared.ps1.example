# Shared PowerShell environment variable template for infrastructure setup.
# These mirror .env.shared.example but use PowerShell assignment syntax.

# Initial/default database created automatically by the Postgres image.
$env:POSTGRES_DB = "bookings"
# Database superuser name used by the shared Postgres container.
$env:POSTGRES_USER = "postgres"
# Database superuser password used by the shared Postgres container.
$env:POSTGRES_PASSWORD = "change_this_database_password"
# Name of the sibling blog database created by the bootstrap shell script.
$env:BLOG_DB_NAME = "blogs"
