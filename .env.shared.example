# Shared environment variable template for infrastructure used by both backends.
# Copy these values into the real .env.shared file and replace placeholders
# before running the shared database stack.

# Initial/default database created automatically by the Postgres image.
POSTGRES_DB=bookings
# Database superuser name used by the shared Postgres container.
POSTGRES_USER=postgres
# Database superuser password used by the shared Postgres container.
POSTGRES_PASSWORD=change_this_database_password
# Name of the sibling blog database created by the bootstrap shell script.
BLOG_DB_NAME=blogs
