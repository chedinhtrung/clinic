# Unified PowerShell deployment environment template.
# This mirrors .env.example but uses PowerShell assignment syntax.

# Shared database credentials used by both Postgres containers.
# Database superuser name used by the shared Postgres container.
$env:POSTGRES_USER = "postgres"
# Database superuser password used by the shared Postgres container.
$env:POSTGRES_PASSWORD = "change_this_database_password"

# Booking backend settings.
# Booking backend connection string for the bookings database.
$env:BOOKING_DB_URL = "postgresql://postgres:change_this_database_password@booking-db:5432/bookings"
# Merchant code used when creating VNPay payment requests.
$env:VNPAY_TMN_CODE = "VNPay_Tmn"
# Secret used to sign and verify VNPay requests.
$env:VNPAY_HASH_SECRET = "VNP_HashSecret"
# Public frontend URL that VNPay redirects customers back to after payment.
$env:VNPAY_RETURN_URL = "https://chedinhnghia.com/payment/result"
# VNPay payment endpoint used to build checkout URLs.
$env:VNPAY_PAYMENT_URL = "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
# SMTP server hostname used for booking confirmation emails.
$env:SMTP_HOST = "smtp.gmail.com"
# SMTP server port used for booking confirmation emails.
$env:SMTP_PORT = "587"
# SMTP login username for sending booking emails.
$env:SMTP_USERNAME = "no-reply@example.com"
# Email address shown as the sender on outgoing booking emails.
$env:SMTP_FROM_EMAIL = "no-reply@example.com"
# Sender display name shown on outgoing booking emails.
$env:SMTP_FROM_NAME = "Clinic Booking"
# SMTP password or app password for the sender mailbox.
$env:SMTP_PASSWORD = "your_smtp_or_app_password"
# Whether the SMTP connection should use STARTTLS.
$env:SMTP_USE_TLS = "true"
# Public frontend URL used for booking, change, confirmation, and chat links.
$env:BOOKING_PUBLIC_BASE_URL = "https://chedinhnghia.com"
# Secret used to sign booking chat links.
$env:CHAT_TOKEN_SECRET = "change_this_long_random_chat_token_secret"
# OpenAI API key used by the booking chat assistant.
$env:OPENAI_API_KEY = "your_openai_api_key"
# OpenAI model used by the booking chat assistant.
$env:OPENAI_CHAT_MODEL = "gpt-4.1-mini"

# Blog backend settings.
# Blog backend connection string for the blogs database.
$env:BLOG_DB_URL = "postgresql://postgres:change_this_database_password@blog-db:5432/blogs"

# Admin frontend settings.
# Shared admin username for the Next.js admin login page.
$env:ADMIN_USERNAME = "admin"
# Shared admin password for the Next.js admin login page.
$env:ADMIN_PASSWORD = "change_this_admin_password"
# Secret used to sign and verify admin session cookies.
$env:ADMIN_SESSION_SECRET = "change_this_long_random_admin_session_secret"
# Private admin backend base URL used by the Next.js server-side proxy.
$env:ADMIN_API_BASE_URL = "http://admin-backend:5002"

# Frontend settings.
# Production frontend routing settings.
# Booking API uses same-origin routing via Nginx, so this stays empty.
$env:NEXT_PUBLIC_API_BASE_URL = ""
# Blog API is exposed behind a separate Nginx path prefix.
$env:NEXT_PUBLIC_BLOG_API_BASE_URL = "/blog-api"
# Chat API is exposed behind a separate Nginx path prefix.
$env:NEXT_PUBLIC_CHAT_API_BASE_URL = "/chat-api"
